# Fim de linha: LF tanto no repositorio quanto no working tree.
# Evita o aviso "LF will be replaced by CRLF" no Windows e mantem os
# diffs limpos entre maquinas. O indice ja estava todo em LF.
* text=auto eol=lf

# Binarios — nunca converter nem tentar fazer diff de texto.
*.png   binary
*.webp  binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.mp4   binary
*.webm  binary
*.pdf   binary
